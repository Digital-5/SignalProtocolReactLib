{
  "include": ["src"],
  "exclude": ["node_modules", "__tests__", "android", "ios"],
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "module": "ES2022",
    "target": "esnext",
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}
